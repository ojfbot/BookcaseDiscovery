{
  "schemaVersion": 1,
  "facets": [
    { "id": "theme", "description": "The human concern the book is about." },
    { "id": "topos", "description": "A recurring place, situation or figure the literature returns to." },
    { "id": "idea", "description": "A specific speculative premise or mechanism the plot depends on." },
    { "id": "question", "description": "What the book keeps asking, open-ended." },
    { "id": "style", "description": "How the prose works: register, tone, density, voice." },
    { "id": "pattern", "description": "The shape of the story, whatever the setting." },
    { "id": "form", "description": "Genre and form labels a catalog or bookshop would shelve by." },
    { "id": "author", "description": "Who wrote it. Authors come from the catalog, so this facet has no terms here." }
  ],
  "terms": [
