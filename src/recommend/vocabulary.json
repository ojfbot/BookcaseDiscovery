      { "source": "isfdb-tag", "match": "artificial intelligence", "terms": [{ "id": "idea:artificial-intelligence" }] },
      { "source": "isfdb-tag", "match": "generation ship", "terms": [{ "id": "topos:generation-ship" }] },
      { "source": "isfdb-tag", "match": "mars", "terms": [{ "id": "topos:mars-frontier" }] },
      { "source": "isfdb-tag", "match": "underground city", "terms": [{ "id": "topos:city-as-system", "weight": 0.5 }] },
      { "source": "isfdb-tag", "match": "cyberpunk", "terms": [{ "id": "form:cyberpunk-fiction" }] },
      { "source": "lcgft", "match": "cyberpunk fiction", "terms": [{ "id": "form:cyberpunk-fiction" }] },
      { "source": "isfdb-tag", "match": "satire", "terms": [{ "id": "style:comic-satirical" }] },
      { "source": "lcgft", "match": "humorous fiction", "terms": [{ "id": "form:humorous-fiction" }, { "id": "style:comic-satirical", "weight": 0.5 }] },
      { "source": "lcgft", "match": "mystery fiction", "terms": [{ "id": "form:mystery-fiction" }] },
      { "source": "lcsh", "match": "space colonies", "terms": [{ "id": "topos:frontier-political-project", "weight": 0.5 }] },
      { "source": "lcsh", "match": "business intelligence", "terms": [{ "id": "idea:corporate-intelligence" }] },
      { "source": "lcsh", "match": "women private investigators", "terms": [{ "id": "pattern:investigation" }] }
    ]
