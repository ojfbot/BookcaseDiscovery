  "crosswalk": {
    "tagWeightDivisor": 3,
    "generic": ["science fiction", "fiction", "novels"],
    "dropPatterns": ["^(\\d+-award|1001 books|abebooks|sf: the 100|into-)", "^user rating", "\\bvotes?\\b"],
    "rules": [
      { "source": "isfdb-tag", "match": "climate change", "terms": [{ "id": "form:climate-fiction" }, { "id": "theme:climate-institutions", "weight": 0.5 }] },
      { "source": "isfdb-tag", "match": "cli-fi", "terms": [{ "id": "form:climate-fiction" }, { "id": "theme:climate-institutions", "weight": 0.5 }] },
