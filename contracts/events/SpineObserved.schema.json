{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ojfbot/BookcaseDiscovery/blob/main/contracts/events/SpineObserved.schema.json",
  "title": "SpineObserved",
  "description": "Payload: the detector found a spine. Raw observation only (INV-3); status starts with a StatusChanged event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["observationId", "sessionId", "imageHash", "setting", "polygon", "score", "shelf", "ordinal", "detector"],
  "properties": {
    "observationId": { "$ref": "../common.schema.json#/definitions/Id" },
    "sessionId": { "$ref": "../common.schema.json#/definitions/Id" },
    "imageHash": { "description": "Hash of the original (ImageAssetIngested.imageHash).", "$ref": "../common.schema.json#/definitions/Sha256" },
    "setting": { "$ref": "../common.schema.json#/definitions/PhotoSetting" },
    "polygon": { "description": "Original-image pixels.", "$ref": "../common.schema.json#/definitions/Polygon" },
    "score": { "description": "Detector confidence.", "$ref": "../common.schema.json#/definitions/Confidence" },
    "shelf": { "description": "Shelf index, 0 = top.", "type": "integer", "minimum": 0 },
    "ordinal": { "description": "Position on the shelf, 0 = leftmost.", "type": "integer", "minimum": 0 },
    "detector": { "$ref": "../common.schema.json#/definitions/DetectorVersion" }
  }
}
