{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ojfbot/BookcaseDiscovery/blob/main/contracts/events/RecommendationRevised.schema.json",
  "title": "RecommendationRevised",
  "description": "Payload: a recommendation changed. Never silent (INV-21): it carries what it was, what it is, and the events that changed it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendationId", "rankingVersion", "recommendation", "previous", "reasonEventSeqs"],
  "properties": {
    "recommendationId": { "$ref": "../common.schema.json#/definitions/Id" },
    "rankingVersion": { "type": "string", "minLength": 1 },
    "recommendation": { "description": "What it is now.", "$ref": "../common.schema.json#/definitions/RecommendationState" },
    "previous": { "description": "What it was.", "$ref": "../common.schema.json#/definitions/RecommendationState" },
    "reasonEventSeqs": { "description": "Ledger positions of the events that changed it.", "type": "array", "minItems": 1, "items": { "$ref": "../common.schema.json#/definitions/Seq" } }
  }
}
