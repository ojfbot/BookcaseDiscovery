{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ojfbot/BookcaseDiscovery/blob/main/contracts/events/CardProposed.schema.json",
  "title": "CardProposed",
  "description": "Payload: a card entered the live list (S9), from the cheap-pass evidence it cites. The card must be on a known track.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cardId",
    "rankingVersion",
    "card",
    "evidenceEventSeqs"
  ],
  "properties": {
    "cardId": {
      "$ref": "../common.schema.json#/definitions/Id"
    },
    "rankingVersion": {
      "type": "string",
      "minLength": 1
    },
    "card": {
      "description": "What it is.",
      "$ref": "../common.schema.json#/definitions/CardState"
    },
    "evidenceEventSeqs": {
      "description": "Ledger positions of the events that made it a card (earlier than this one).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.schema.json#/definitions/Seq"
      }
    }
  }
}
