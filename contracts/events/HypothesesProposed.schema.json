{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ojfbot/BookcaseDiscovery/blob/main/contracts/events/HypothesesProposed.schema.json",
  "title": "HypothesesProposed",
  "description": "Payload: ranked candidates for one spine plus the explicit unknown (INV-5), each with evidence. Interpretation, stored apart from the observation (INV-3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["observationId", "candidates", "unknown"],
  "properties": {
    "observationId": { "$ref": "../common.schema.json#/definitions/Id" },
    "candidates": {
      "description": "Best first. May be empty (no catalog candidate).",
      "type": "array",
      "items": { "$ref": "#/definitions/Candidate" }
    },
    "unknown": {
      "description": "The none-of-the-above hypothesis. Required, so no match is ever forced.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "evidence"],
      "properties": {
        "score": { "type": "number" },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/Evidence" } }
      }
    }
  },
  "definitions": {
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "score"],
      "properties": {
        "kind": { "enum": ["title-fragment", "author-fragment", "isbn", "series", "neighbour", "adjudication", "correction", "threshold"] },
        "score": { "type": "number" },
        "detail": { "type": "string" }
      }
    },
    "Candidate": {
      "description": "A Work (and optionally one Edition of it). Work and Edition stay separate (INV-3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["workId", "title", "author", "score", "evidence"],
      "properties": {
        "workId": { "$ref": "../common.schema.json#/definitions/Id" },
        "editionId": { "$ref": "../common.schema.json#/definitions/Id" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "year": { "type": "integer" },
        "series": { "type": "string", "minLength": 1 },
        "score": { "type": "number" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Evidence" } }
      }
    }
  }
}
