          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "BandAssigned"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/BandAssigned.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "StatusChanged"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
