{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ojfbot/BookcaseDiscovery/blob/main/contracts/event.schema.json",
  "title": "Event",
  "description": "The ledger envelope. 'type' selects which events/<type>.schema.json the payload must satisfy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "ts",
    "runId",
    "payload"
  ],
  "properties": {
    "seq": {
      "description": "Assigned by the ledger on append; absent on a new event.",
      "$ref": "common.schema.json#/definitions/Seq"
    },
    "type": {
      "enum": [
        "ScanSessionOpened",
        "ImageAssetIngested",
        "ImageRejected",
        "SpineObserved",
        "TextObserved",
        "HypothesesProposed",
        "AdjudicationRecorded",
        "BandAssigned",
        "StatusChanged",
        "WorkItemOpened",
        "WorkItemClosed",
        "IdentityCorrected",
        "PreferenceRecorded",
        "RecommendationIssued",
        "RecommendationRevised",
        "RunStarted",
        "RunFinished",
        "Track",
        "FrameSample",
        "TrackWindow",
        "OcrReading",
        "LookupResult",
        "AdjudicationRequested",
        "AdjudicationResult",
        "AdjudicationCacheHit",
        "CardProposed",
        "CardRevised",
        "CardRetracted",
        "CardUndo"
      ]
    },
    "ts": {
      "description": "When it happened, supplied by the emitter (never stamped by the ledger, so replay is deterministic).",
      "$ref": "common.schema.json#/definitions/Timestamp"
    },
    "runId": {
      "description": "The run that emitted it.",
      "$ref": "common.schema.json#/definitions/Id"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "ScanSessionOpened"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/ScanSessionOpened.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ImageAssetIngested"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/ImageAssetIngested.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ImageRejected"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/ImageRejected.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SpineObserved"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/SpineObserved.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TextObserved"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/TextObserved.schema.json"
          }
        }
      }
    },
    {
      "if": {
