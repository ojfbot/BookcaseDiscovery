{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ojfbot/BookcaseDiscovery/blob/main/contracts/helpers/ocr-request.schema.json",
  "title": "ocr request",
  "description": "One JSON Lines record on the OCR helper's stdin: read one spine at the listed rotations, with language correction off and on.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "image",
    "polygon",
    "rotations"
  ],
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/definitions/Id"
    },
    "image": {
      "description": "Path to the GPS-stripped working copy.",
      "type": "string",
      "minLength": 1
    },
    "polygon": {
      "description": "Spine box in that image's pixels.",
      "$ref": "../common.schema.json#/definitions/Polygon"
    },
    "rotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.schema.json#/definitions/Rotation"
      }
    }
  }
}
