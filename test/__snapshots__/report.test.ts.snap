    <main class="grid">
      <section aria-label="Photo and overlay">
        <div class="controls">
          <div class="chips" role="group" aria-label="Show spines by status (others dim, none are removed)">
            <button class="chip" data-lens="all" aria-pressed="true">
              "All"
            <button class="chip" data-lens="resolved" aria-pressed="false">
              <svg viewBox="0 0 16 12" aria-hidden="true">
                <rect width="16" height="12">
                <rect width="14.5" height="10.5">
              "resolved"
            <button class="chip" data-lens="unresolved" aria-pressed="false">
              <svg viewBox="0 0 16 12" aria-hidden="true">
                <pattern id="lg-unresolved" width="5" height="5">
                <rect width="16" height="12">
                <rect width="14.5" height="10.5">
              "unresolved"
            <button class="chip" data-lens="needs-pixels" aria-pressed="false">
              <svg viewBox="0 0 16 12" aria-hidden="true">
                <pattern id="lg-needs-pixels" width="5" height="5">
                <rect width="16" height="12">
                <rect width="14.5" height="10.5">
