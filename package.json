{
  "name": "bookcase-discovery",
  "version": "0.0.0",
  "private": true,
  "description": "Point a phone at a bookshelf: spine recognition and taste-based book discovery.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "bookcase": "bin/bookcase"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "labels:import": "node src/eval/labels-import.ts",
    "catalog:import": "node src/catalog/isfdb-import.ts import",
    "catalog:check": "node src/catalog/isfdb-import.ts check",
    "guard": "node scripts/privacy-guard.mjs",
    "prepare": "simple-git-hooks",
    "report:synthetic": "node scripts/synthetic-report.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -f scripts/privacy-guard.mjs ]; then node scripts/privacy-guard.mjs; fi"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "zod": "^4.6.7"
  }
}
